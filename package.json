    "images:normalize": "node scripts/normalize-images.mjs",
    "links:enrich": "node scripts/enrich-links.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/markdoc": "^2.1.5",
