# Copy to `.dev.vars` (wrangler dev / preview) or set in the Cloudflare dashboard for production.
# `astro dev` needs none of these: the Studio runs in local mode with no auth.

# Canonical origin. Change once a domain is bought.
SITE_URL=https://me.mfalfath25.workers.dev

# Studio gate (layer 1): HTTP Basic Auth in front of /keystatic. Secrets.
STUDIO_BASIC_AUTH_USER=
STUDIO_BASIC_AUTH_PASSWORD=

# Studio GitHub mode (layer 2). Created by Keystatic's GitHub App setup flow. Secrets.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
# Public (build-time) variable.
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Cloudflare Web Analytics site token (public). Leave empty to disable.
PUBLIC_CF_ANALYTICS_TOKEN=
