---
import { getImage } from 'astro:assets';

import ArchiveGrid from '@/components/content/ArchiveGrid.astro';
import type { Locale } from '@/i18n/config';
import { alternatesFor, localizePath } from '@/i18n/paths';
import { t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Album, Photo } from '@/lib/content';
import { routes } from '@/lib/routes';
import { breadcrumbLd, imageGalleryLd } from '@/lib/seo/jsonld';

interface Props {
  album: Album;
  locale: Locale;
}
const { album, locale } = Astro.props;
const photos = album.items.filter((i): i is Photo => i.kind === 'photo');
const galleryImages = await Promise.all(
  photos.map(async (p) => ({
    src: (await getImage({ src: p.image, width: 1600, format: 'jpeg' })).src,
    alt: p.alt,
    title: p.title,
  })),
);
const description = album.description ?? `${album.title} · ${t(locale, 'archive.title')}`;
---

<BaseLayout
  title={album.title}
  description={description}
  locale={locale}
  alternates={alternatesFor(Astro.url.pathname)}
  image={album.cover?.image ?? null}
  imageAlt={album.cover?.alt}
  jsonLd={[
    imageGalleryLd(Astro.site!, { name: album.title, path: Astro.url.pathname, images: galleryImages }),
    breadcrumbLd(Astro.site!, [
      { name: t(locale, 'archive.title'), path: localizePath(routes.archive(), locale) },
      { name: album.title, path: Astro.url.pathname },
    ]),
  ]}
>
  <p class="text-sm text-(--color-muted)">
    <a href={localizePath(routes.archive(), locale)} class="hover:text-(--color-fg)">
      ← {t(locale, 'archive.title')}
    </a>
  </p>
  <h1 class="mt-2 text-3xl font-semibold tracking-tight">{album.title}</h1>
  {album.description && <p class="mt-2 max-w-2xl text-(--color-muted)">{album.description}</p>}
  <div class="mt-8">
    <ArchiveGrid items={album.items} />
  </div>
</BaseLayout>
