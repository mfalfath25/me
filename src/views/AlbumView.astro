---
import { getImage } from 'astro:assets';

import LinkList from '@/components/content/LinkList.astro';
import PhotoWall from '@/components/content/PhotoWall.astro';
import type { Locale } from '@/i18n/config';
import { alternatesFor, localizePath } from '@/i18n/paths';
import { t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Album, Link, Photo } from '@/lib/content';
import { routes } from '@/lib/routes';
import { breadcrumbLd, imageGalleryLd } from '@/lib/seo/jsonld';

interface Props {
  album: Album;
  locale: Locale;
}
const { album, locale } = Astro.props;
const photos = album.items.filter((i): i is Photo => i.kind === 'photo');
const links = album.items.filter((i): i is Link => i.kind === 'link');
const galleryImages = await Promise.all(
  photos.map(async (p) => ({
    src: (await getImage({ src: p.image, width: 1600, format: 'jpeg' })).src,
    alt: p.alt,
    title: p.title,
  })),
);
const description = album.description ?? `${album.title}, ${t(locale, 'archive.title')}`;
---

<BaseLayout
  title={album.title}
  description={description}
  locale={locale}
  alternates={alternatesFor(Astro.url.pathname)}
  image={album.cover?.image ?? null}
  imageAlt={album.cover?.alt}
  jsonLd={[
    imageGalleryLd(Astro.site!, { name: album.title, path: Astro.url.pathname, images: galleryImages }),
    breadcrumbLd(Astro.site!, [
      { name: t(locale, 'archive.title'), path: localizePath(routes.archive(), locale) },
      { name: album.title, path: Astro.url.pathname },
    ]),
  ]}
>
  <header class="page-head">
    <h1 class="title">{album.title}</h1>
    <p class="meta">
      {t(locale, 'archive.albums')},{' '}
      <a href={localizePath(routes.archive(), locale)} class="text-link">
        {t(locale, 'archive.title')}
      </a>
    </p>
    {album.description && <p class="lede">{album.description}</p>}
  </header>
  {photos.length > 0 && <PhotoWall photos={photos} locale={locale} />}
  {links.length > 0 && (
    <section aria-labelledby="album-links">
      <div class="section__head">
        <h2 id="album-links">{t(locale, 'archive.links')}</h2>
      </div>
      <LinkList links={links} />
    </section>
  )}
</BaseLayout>
