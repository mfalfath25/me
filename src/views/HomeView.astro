---
import PhotoWall from '@/components/content/PhotoWall.astro';
import PostCard from '@/components/content/PostCard.astro';
import WorkCard from '@/components/content/WorkCard.astro';
import type { Locale } from '@/i18n/config';
import { alternatesFor, localizePath } from '@/i18n/paths';
import { t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { listArchiveItems, listPosts, listWorks, type Photo } from '@/lib/content';
import { routes } from '@/lib/routes';
import { personLd, websiteLd } from '@/lib/seo/jsonld';
import { site } from '@/lib/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const [posts, archive, works] = await Promise.all([listPosts(locale), listArchiveItems(), listWorks(locale)]);
const featured = works.filter((p) => p.featured);
const photos = archive.filter((i): i is Photo => i.kind === 'photo');
const origin = Astro.site!;
---

<BaseLayout
  title={site.name}
  description={site.description[locale]}
  locale={locale}
  alternates={alternatesFor(Astro.url.pathname)}
  type="profile"
  jsonLd={[websiteLd(origin, locale), personLd(origin)]}
>
  <section class="page-head page-head--one">
    <h1 class="title">{site.description[locale]}</h1>
  </section>

  <section aria-labelledby="latest-writing">
    <div class="section__head">
      <h2 id="latest-writing">{t(locale, 'home.latestWriting')}</h2>
      <a href={localizePath(routes.writing(), locale)} class="section__more">
        {t(locale, 'home.seeAll')}
      </a>
    </div>
    <div class="rows">
      {posts.slice(0, 3).map((post) => (
        <PostCard post={post} locale={locale} />
      ))}
    </div>
  </section>

  <section aria-labelledby="from-archive">
    <div class="section__head">
      <h2 id="from-archive">{t(locale, 'home.fromArchive')}</h2>
      <a href={localizePath(routes.archive(), locale)} class="section__more">
        {t(locale, 'home.seeAll')}
      </a>
    </div>
    <PhotoWall photos={photos.slice(0, 6)} locale={locale} eager={0} />
  </section>

  {featured.length > 0 && (
    <section aria-labelledby="selected-works">
      <div class="section__head">
        <h2 id="selected-works">{t(locale, 'home.selectedWorks')}</h2>
        <a href={localizePath(routes.works(), locale)} class="section__more">
          {t(locale, 'home.seeAll')}
        </a>
      </div>
      <div class="works">
        {featured.slice(0, 4).map((work) => (
          <WorkCard work={work} locale={locale} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
