---
import ArchiveGrid from '@/components/content/ArchiveGrid.astro';
import PostCard from '@/components/content/PostCard.astro';
import ProjectCard from '@/components/content/ProjectCard.astro';
import type { Locale } from '@/i18n/config';
import { alternatesFor, localizePath } from '@/i18n/paths';
import { t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { listArchiveItems, listPosts, listProjects } from '@/lib/content';
import { routes } from '@/lib/routes';
import { personLd, websiteLd } from '@/lib/seo/jsonld';
import { site } from '@/lib/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const [posts, archive, projects] = await Promise.all([listPosts(locale), listArchiveItems(), listProjects(locale)]);
const featured = projects.filter((p) => p.featured);
const origin = Astro.site!;
---

<BaseLayout
  title={site.name}
  description={site.description[locale]}
  locale={locale}
  alternates={alternatesFor(Astro.url.pathname)}
  type="profile"
  jsonLd={[websiteLd(origin, locale), personLd(origin)]}
>
  <section class="max-w-2xl">
    <h1 class="text-3xl font-semibold tracking-tight">{site.name}</h1>
    <p class="mt-3 text-(--color-muted)">{site.description[locale]}</p>
  </section>

  <section class="mt-16" aria-labelledby="latest-writing">
    <div class="flex items-baseline justify-between">
      <h2 id="latest-writing" class="text-sm font-semibold uppercase tracking-wide">
        {t(locale, 'home.latestWriting')}
      </h2>
      <a href={localizePath(routes.writing(), locale)} class="text-sm text-(--color-muted) hover:text-(--color-fg)">
        {t(locale, 'home.seeAll')} →
      </a>
    </div>
    <div class="divide-y divide-(--color-line)">
      {posts.slice(0, 3).map((post) => (
        <PostCard post={post} locale={locale} />
      ))}
    </div>
  </section>

  <section class="mt-16" aria-labelledby="from-archive">
    <div class="mb-4 flex items-baseline justify-between">
      <h2 id="from-archive" class="text-sm font-semibold uppercase tracking-wide">
        {t(locale, 'home.fromArchive')}
      </h2>
      <a href={localizePath(routes.archive(), locale)} class="text-sm text-(--color-muted) hover:text-(--color-fg)">
        {t(locale, 'home.seeAll')} →
      </a>
    </div>
    <ArchiveGrid items={archive.slice(0, 6)} eager={0} />
  </section>

  {featured.length > 0 && (
    <section class="mt-16" aria-labelledby="selected-projects">
      <div class="mb-4 flex items-baseline justify-between">
        <h2 id="selected-projects" class="text-sm font-semibold uppercase tracking-wide">
          {t(locale, 'home.selectedProjects')}
        </h2>
        <a href={localizePath(routes.projects(), locale)} class="text-sm text-(--color-muted) hover:text-(--color-fg)">
          {t(locale, 'home.seeAll')} →
        </a>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {featured.slice(0, 4).map((project) => (
          <ProjectCard project={project} locale={locale} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
