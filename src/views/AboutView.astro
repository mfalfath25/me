---
import TranslationNotice from '@/components/content/TranslationNotice.astro';
import type { Locale } from '@/i18n/config';
import { alternatesFor } from '@/i18n/paths';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAboutPage } from '@/lib/content';
import { personLd } from '@/lib/seo/jsonld';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const page = await getAboutPage(locale);
const { Content } = await page.render();
---

<BaseLayout
  title={page.title}
  description={page.description}
  locale={locale}
  alternates={alternatesFor(Astro.url.pathname)}
  type="profile"
  jsonLd={[{ '@type': 'ProfilePage', mainEntity: personLd(Astro.site!) }]}
>
  {page.isFallback && <TranslationNotice locale={locale} />}
  <article lang={page.locale}>
    <h1 class="text-3xl font-semibold tracking-tight">{page.title}</h1>
    <div class="prose mt-8">
      <Content />
    </div>
  </article>
</BaseLayout>
