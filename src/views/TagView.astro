---
import LinkList from '@/components/content/LinkList.astro';
import PhotoWall from '@/components/content/PhotoWall.astro';
import PostCard from '@/components/content/PostCard.astro';
import WorkCard from '@/components/content/WorkCard.astro';
import type { Locale } from '@/i18n/config';
import { alternatesFor } from '@/i18n/paths';
import { t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Link, Photo, TaggedContent } from '@/lib/content';
import { breadcrumbLd } from '@/lib/seo/jsonld';

interface Props {
  content: TaggedContent;
  locale: Locale;
}
const { content, locale } = Astro.props;
const { tag, posts, works, archive } = content;
const photos = archive.filter((i): i is Photo => i.kind === 'photo');
const links = archive.filter((i): i is Link => i.kind === 'link');
const description = tag.description ?? `${t(locale, 'tags.title')}: ${tag.name}`;
---

<BaseLayout
  title={`#${tag.name}`}
  description={description}
  locale={locale}
  alternates={alternatesFor(Astro.url.pathname)}
  jsonLd={[breadcrumbLd(Astro.site!, [{ name: `#${tag.name}`, path: Astro.url.pathname }])]}
>
  <header class="page-head">
    <h1 class="title">#{tag.name}</h1>
    {tag.description && <p class="lede">{tag.description}</p>}
  </header>

  {posts.length > 0 && (
    <section aria-labelledby="tagged-writing">
      <div class="section__head">
        <h2 id="tagged-writing">{t(locale, 'nav.writing')}</h2>
      </div>
      <div class="rows">
        {posts.map((post) => (
          <PostCard post={post} locale={locale} />
        ))}
      </div>
    </section>
  )}
  {works.length > 0 && (
    <section aria-labelledby="tagged-works">
      <div class="section__head">
        <h2 id="tagged-works">{t(locale, 'nav.works')}</h2>
      </div>
      <div class="works">
        {works.map((work) => (
          <WorkCard work={work} locale={locale} />
        ))}
      </div>
    </section>
  )}
  {photos.length > 0 && (
    <section aria-labelledby="tagged-photos">
      <div class="section__head">
        <h2 id="tagged-photos">{t(locale, 'archive.photos')}</h2>
      </div>
      <PhotoWall photos={photos} locale={locale} eager={0} />
    </section>
  )}
  {links.length > 0 && (
    <section aria-labelledby="tagged-links">
      <div class="section__head">
        <h2 id="tagged-links">{t(locale, 'archive.links')}</h2>
      </div>
      <LinkList links={links} />
    </section>
  )}
</BaseLayout>
