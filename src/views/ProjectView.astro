---
import { getImage } from 'astro:assets';

import ResponsiveImage from '@/components/media/ResponsiveImage.astro';
import TagList from '@/components/content/TagList.astro';
import TranslationNotice from '@/components/content/TranslationNotice.astro';
import type { Locale } from '@/i18n/config';
import { localizePath } from '@/i18n/paths';
import { t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Project } from '@/lib/content';
import { routes } from '@/lib/routes';
import { breadcrumbLd, creativeWorkLd } from '@/lib/seo/jsonld';

interface Props {
  project: Project;
  locale: Locale;
}
const { project, locale } = Astro.props;
const { Content } = await project.render();
const origin = Astro.site!;
const path = localizePath(routes.project(project.slug), locale);
const alternates = Object.fromEntries(
  project.availableLocales.map((l) => [l, localizePath(routes.project(project.slug), l)]),
);
const coverForLd = project.cover ? (await getImage({ src: project.cover, width: 1200, format: 'jpeg' })).src : null;

const facts = [
  project.role && { label: t(locale, 'projects.role'), value: project.role },
  project.period && { label: t(locale, 'projects.period'), value: project.period },
  project.stack.length > 0 && { label: t(locale, 'projects.stack'), value: project.stack.join(', ') },
].filter(Boolean) as { label: string; value: string }[];
---

<BaseLayout
  title={project.title}
  description={project.summary}
  locale={locale}
  alternates={alternates}
  canonicalPath={project.isFallback ? localizePath(routes.project(project.slug), project.locale) : undefined}
  noindex={project.isFallback || project.isHidden}
  image={project.cover}
  imageAlt={project.coverAlt}
  type="article"
  publishedAt={project.publishedAt}
  tags={project.tags.map((tag) => tag.name)}
  jsonLd={[
    creativeWorkLd(origin, {
      title: project.title,
      description: project.summary,
      path,
      locale: project.locale,
      image: coverForLd,
      tags: project.tags.map((tag) => tag.name),
    }),
    breadcrumbLd(origin, [
      { name: t(locale, 'projects.title'), path: localizePath(routes.projects(), locale) },
      { name: project.title, path },
    ]),
  ]}
>
  {project.isFallback && <TranslationNotice locale={locale} />}
  <article lang={project.locale}>
    <!-- Overview -->
    <header class="max-w-[68ch]">
      <p class="text-sm text-(--color-muted)">{t(locale, `projects.status.${project.status}`)}</p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight md:text-4xl">{project.title}</h1>
      <p class="mt-3 text-lg text-(--color-muted)">{project.summary}</p>
      {facts.length > 0 && (
        <dl class="mt-6 grid grid-cols-[max-content_1fr] gap-x-6 gap-y-1 text-sm">
          {facts.map((f) => (
            <>
              <dt class="text-(--color-muted)">{f.label}</dt>
              <dd>{f.value}</dd>
            </>
          ))}
        </dl>
      )}
      {project.links.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-4 text-sm">
          {project.links.map((link) => (
            <li>
              <a href={link.url} rel="noopener" target="_blank" class="underline underline-offset-4">
                {link.label} ↗
              </a>
            </li>
          ))}
        </ul>
      )}
    </header>

    {project.cover && (
      <ResponsiveImage
        src={project.cover}
        alt={project.coverAlt}
        widths={[640, 1024, 1600]}
        sizes="(min-width: 1024px) 1024px, 100vw"
        priority
        class="mt-8 w-full rounded-md"
      />
    )}

    <!-- Details -->
    <div class="prose mt-10">
      <Content />
    </div>

    <footer class="mt-12 max-w-[68ch] border-t border-(--color-line) pt-6">
      <TagList tags={project.tags} locale={locale} />
    </footer>
  </article>
</BaseLayout>
