---
import { getImage } from 'astro:assets';

import ResponsiveImage from '@/components/media/ResponsiveImage.astro';
import TagList from '@/components/content/TagList.astro';
import TranslationNotice from '@/components/content/TranslationNotice.astro';
import type { Locale } from '@/i18n/config';
import { localizePath } from '@/i18n/paths';
import { formatDate, t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Post } from '@/lib/content';
import { routes } from '@/lib/routes';
import { blogPostingLd, breadcrumbLd } from '@/lib/seo/jsonld';

interface Props {
  post: Post;
  /** Locale of the URL being rendered (may differ from post.locale on fallback pages). */
  locale: Locale;
}
const { post, locale } = Astro.props;
const { Content } = await post.render();
const origin = Astro.site!;
const path = localizePath(routes.post(post.slug), locale);
const alternates = Object.fromEntries(post.availableLocales.map((l) => [l, localizePath(routes.post(post.slug), l)]));
const coverForLd = post.cover ? (await getImage({ src: post.cover, width: 1200, format: 'jpeg' })).src : null;
---

<BaseLayout
  title={post.title}
  description={post.description}
  locale={locale}
  alternates={alternates}
  canonicalPath={post.isFallback ? localizePath(routes.post(post.slug), post.locale) : undefined}
  noindex={post.isFallback || post.isHidden}
  image={post.cover}
  imageAlt={post.coverAlt}
  type="article"
  publishedAt={post.publishedAt}
  updatedAt={post.updatedAt}
  tags={post.tags.map((tag) => tag.name)}
  jsonLd={[
    blogPostingLd(origin, { ...post, path, image: coverForLd, tags: post.tags.map((tag) => tag.name) }),
    breadcrumbLd(origin, [
      { name: t(locale, 'writing.title'), path: localizePath(routes.writing(), locale) },
      { name: post.title, path },
    ]),
  ]}
>
  <article class="article" lang={post.locale}>
    {post.isFallback && <TranslationNotice locale={locale} />}
    <header class="article__head">
      <h1 class="title">{post.title}</h1>
      <p class="meta">
        <time datetime={post.publishedAt.toISOString()}>{formatDate(post.publishedAt, locale)}</time>
        {post.updatedAt && (
          <span>
            , {t(locale, 'updated')}{' '}
            <time datetime={post.updatedAt.toISOString()}>{formatDate(post.updatedAt, locale)}</time>
          </span>
        )}
        {post.isHidden && <span> ({t(locale, 'draft')})</span>}
      </p>
      {post.series && (
        <p class="meta">
          {t(locale, 'writing.partOf')}{' '}
          <a href={localizePath(routes.series(post.series.slug), locale)} class="text-link">
            {post.series.title}
          </a>
          {post.series.order != null && <span>, #{post.series.order}</span>}
        </p>
      )}
    </header>

    {post.cover && (
      <ResponsiveImage
        src={post.cover}
        alt={post.coverAlt}
        widths={[640, 1024, 1600]}
        sizes="(min-width: 1024px) 960px, 100vw"
        priority
        class="article__cover"
      />
    )}

    <div class="prose article__body">
      <Content />
    </div>

    <footer class="article__foot">
      <TagList tags={post.tags} locale={locale} />
    </footer>
  </article>
</BaseLayout>
