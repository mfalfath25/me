---
import PostCard from '@/components/content/PostCard.astro';
import type { Locale } from '@/i18n/config';
import { alternatesFor, localizePath } from '@/i18n/paths';
import { t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Post, Series } from '@/lib/content';
import { routes } from '@/lib/routes';
import { breadcrumbLd } from '@/lib/seo/jsonld';

interface Props {
  series: Series;
  posts: Post[];
  locale: Locale;
}
const { series, posts, locale } = Astro.props;
---

<BaseLayout
  title={series.title}
  description={series.description ?? series.title}
  locale={locale}
  alternates={alternatesFor(Astro.url.pathname)}
  jsonLd={[
    breadcrumbLd(Astro.site!, [
      { name: t(locale, 'writing.title'), path: localizePath(routes.writing(), locale) },
      { name: series.title, path: Astro.url.pathname },
    ]),
  ]}
>
  <header class="page-head">
    <h1 class="title">{series.title}</h1>
    <p class="meta">
      {t(locale, 'writing.series')},{' '}
      <a href={localizePath(routes.writing(), locale)} class="text-link">
        {t(locale, 'writing.title')}
      </a>
    </p>
    {series.description && <p class="lede">{series.description}</p>}
  </header>
  <ol class="rows">
    {posts.map((post) => (
      <li>
        <PostCard post={post} locale={locale} />
      </li>
    ))}
  </ol>
</BaseLayout>
