---
import PostCard from '@/components/content/PostCard.astro';
import type { Locale } from '@/i18n/config';
import { alternatesFor, localizePath } from '@/i18n/paths';
import { t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { listPosts, listSeries } from '@/lib/content';
import { routes } from '@/lib/routes';
import { breadcrumbLd } from '@/lib/seo/jsonld';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const [posts, allSeries] = await Promise.all([listPosts(locale), listSeries()]);
const series = allSeries.filter((s) => posts.some((p) => p.series?.slug === s.slug));
const title = t(locale, 'writing.title');
---

<BaseLayout
  title={title}
  description={t(locale, 'writing.description')}
  locale={locale}
  alternates={alternatesFor(Astro.url.pathname)}
  jsonLd={[breadcrumbLd(Astro.site!, [{ name: title, path: Astro.url.pathname }])]}
>
  <header class="page-head">
    <h1 class="title title--menu">{title}</h1>
    <p class="lede">{t(locale, 'writing.description')}</p>
    {series.length > 0 && (
      <nav aria-label={t(locale, 'writing.series')}>
        <ul class="inline-list">
          <li class="meta">{t(locale, 'writing.series')}</li>
          {series.map((s) => (
            <li>
              <a href={localizePath(routes.series(s.slug), locale)}>{s.title}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </header>

  <div class="rows">
    {posts.map((post) => (
      <PostCard post={post} locale={locale} />
    ))}
  </div>
</BaseLayout>
