---
import TranslationNotice from '@/components/content/TranslationNotice.astro';
import type { Locale } from '@/i18n/config';
import { alternatesFor } from '@/i18n/paths';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getReadmePage } from '@/lib/content';
import { personLd } from '@/lib/seo/jsonld';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const page = await getReadmePage(locale);
const { Content } = await page.render();
---

<BaseLayout
  title={page.title}
  description={page.description}
  locale={locale}
  alternates={alternatesFor(Astro.url.pathname)}
  type="profile"
  jsonLd={[{ '@type': 'ProfilePage', mainEntity: personLd(Astro.site!) }]}
>
  <article class="article" lang={page.locale}>
    {page.isFallback && <TranslationNotice locale={locale} />}
    <header class="article__head">
      <h1 class="title title--menu">{page.title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
