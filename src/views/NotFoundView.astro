---
import type { Locale } from '@/i18n/config';
import { localizePath } from '@/i18n/paths';
import { t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<BaseLayout title={t(locale, 'notFound.title')} description={t(locale, 'notFound.body')} locale={locale} noindex>
  <header class="page-head">
    <h1 class="title">{t(locale, 'notFound.title')}</h1>
    <p class="lede">{t(locale, 'notFound.body')}</p>
    <p>
      <a href={localizePath('/', locale)} class="text-link">
        {t(locale, 'notFound.home')}
      </a>
    </p>
  </header>
</BaseLayout>
