---
import ProjectCard from '@/components/content/ProjectCard.astro';
import type { Locale } from '@/i18n/config';
import { alternatesFor } from '@/i18n/paths';
import { t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { listProjects } from '@/lib/content';
import { breadcrumbLd } from '@/lib/seo/jsonld';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const projects = await listProjects(locale);
const title = t(locale, 'projects.title');
---

<BaseLayout
  title={title}
  description={t(locale, 'projects.description')}
  locale={locale}
  alternates={alternatesFor(Astro.url.pathname)}
  jsonLd={[breadcrumbLd(Astro.site!, [{ name: title, path: Astro.url.pathname }])]}
>
  <h1 class="text-3xl font-semibold tracking-tight">{title}</h1>
  <p class="mt-2 text-(--color-muted)">{t(locale, 'projects.description')}</p>
  <div class="mt-10 grid gap-10 md:grid-cols-2">
    {projects.map((project) => (
      <ProjectCard project={project} locale={locale} />
    ))}
  </div>
</BaseLayout>
