---
import { getImage } from 'astro:assets';

import ArchiveGrid from '@/components/content/ArchiveGrid.astro';
import type { Locale } from '@/i18n/config';
import { alternatesFor, localizePath } from '@/i18n/paths';
import { t } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { listAlbums, listArchiveItems } from '@/lib/content';
import { routes } from '@/lib/routes';
import { breadcrumbLd, imageGalleryLd } from '@/lib/seo/jsonld';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const [items, albums] = await Promise.all([listArchiveItems(), listAlbums()]);
const title = t(locale, 'archive.title');
const photos = items.filter((i) => i.kind === 'photo');
const galleryImages = await Promise.all(
  photos.slice(0, 50).map(async (p) => ({
    src: (await getImage({ src: p.image, width: 1600, format: 'jpeg' })).src,
    alt: p.alt,
    title: p.title,
  })),
);
---

<BaseLayout
  title={title}
  description={t(locale, 'archive.description')}
  locale={locale}
  alternates={alternatesFor(Astro.url.pathname)}
  image={photos[0]?.image ?? null}
  imageAlt={photos[0]?.alt}
  jsonLd={[
    imageGalleryLd(Astro.site!, { name: title, path: Astro.url.pathname, images: galleryImages }),
    breadcrumbLd(Astro.site!, [{ name: title, path: Astro.url.pathname }]),
  ]}
>
  <h1 class="text-3xl font-semibold tracking-tight">{title}</h1>
  <p class="mt-2 text-(--color-muted)">{t(locale, 'archive.description')}</p>

  {albums.length > 0 && (
    <nav aria-label={t(locale, 'archive.albums')} class="mt-8 text-sm">
      <ul class="flex flex-wrap gap-2">
        {albums.map((album) => (
          <li>
            <a
              href={localizePath(routes.album(album.slug), locale)}
              class="rounded-full border border-(--color-line) px-3 py-1 hover:border-(--color-fg)"
            >
              {album.title} <span class="text-(--color-muted)">{album.items.length}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <div class="mt-8">
    <ArchiveGrid items={items} />
  </div>
</BaseLayout>
