---
/**
 * The rail: a stacked text column on the left. Signature (home link), the main nav, then the
 * theme and language switches and the colophon at its foot. No panel, no border: it sits on the
 * grid like everything else. On phones it becomes a two-row block above the page.
 */
import type { Locale } from '@/i18n/config';
import { localizePath, splitLocale } from '@/i18n/paths';
import { t } from '@/i18n/ui';
import { routes } from '@/lib/routes';
import { site } from '@/lib/site';

import Footer from './Footer.astro';
import LanguageToggle from './LanguageToggle.astro';
import Signature from './Signature.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const current = splitLocale(Astro.url.pathname).path;

const nav = [
  { href: routes.writing(), label: t(locale, 'nav.writing') },
  { href: routes.archive(), label: t(locale, 'nav.archive') },
  { href: routes.works(), label: t(locale, 'nav.works') },
  { href: routes.about(), label: t(locale, 'nav.about') },
];
---

<header class="rail">
  <a href={localizePath('/', locale)} class="signature-link">
    <Signature title={`${site.name}, ${t(locale, 'nav.home')}`} />
  </a>
  <nav aria-label="Main">
    <ul class="rail__nav">
      {nav.map((item) => (
        <li>
          <a
            href={localizePath(item.href, locale)}
            class="rail__link"
            aria-current={current === item.href || current.startsWith(`${item.href}/`) ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="rail__foot">
    <ThemeToggle locale={locale} />
    <LanguageToggle locale={locale} />
    <Footer locale={locale} />
  </div>
</header>

<script>
  // Mark the signature as drawn for the rest of the visit, so it animates once.
  try {
    sessionStorage.setItem('signed', '1');
  } catch {
    /* storage blocked: the signature simply draws on every page */
  }
</script>
