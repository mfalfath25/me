---
import type { Locale } from '@/i18n/config';
import { localizePath } from '@/i18n/paths';
import { routes } from '@/lib/routes';
import { site } from '@/lib/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<footer class="border-t border-(--color-line) text-sm text-(--color-muted)">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-5 py-6">
    <p>
      © {new Date().getFullYear()} {site.author.name}
    </p>
    <ul class="flex gap-4">
      {site.socials.map((s) => (
        <li>
          <a href={s.href} rel="me noopener" target="_blank" class="hover:text-(--color-fg)">
            {s.label}
          </a>
        </li>
      ))}
      <li>
        <a href={localizePath(routes.rss(), locale)} class="hover:text-(--color-fg)">
          RSS
        </a>
      </li>
    </ul>
  </div>
</footer>
