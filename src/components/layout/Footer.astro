---
/**
 * The colophon. There is no visible page footer: these links sit at the foot of the rail
 * (hidden on phones, where the rail is a compact block; RSS stays discoverable via <link>).
 */
import type { Locale } from '@/i18n/config';
import { localizePath } from '@/i18n/paths';
import { t } from '@/i18n/ui';
import { routes } from '@/lib/routes';
import { site } from '@/lib/site';

import SocialIcon from './SocialIcon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<footer class="colophon">
  <ul>
    {site.socials.map((s) => (
      <li>
        <a href={s.href} class="social" rel="me noopener" target="_blank" aria-label={s.label}>
          <SocialIcon name={s.id} />
        </a>
      </li>
    ))}
    <li>
      <a href={`mailto:${site.email}`} class="social" aria-label={t(locale, 'email.label')}>
        <SocialIcon name="email" />
      </a>
    </li>
    {site.rssIcon && (
      <li>
        <a href={localizePath(routes.rss(), locale)} class="social" aria-label={t(locale, 'rss.label')}>
          <SocialIcon name="rss" />
        </a>
      </li>
    )}
  </ul>
  <p>
    © {new Date().getFullYear()} {site.author.name}
  </p>
</footer>
