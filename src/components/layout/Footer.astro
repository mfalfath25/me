---
/**
 * The colophon. There is no visible page footer: these links sit at the foot of the rail
 * (hidden on phones, where the rail is a compact block; RSS stays discoverable via <link>).
 */
import type { Locale } from '@/i18n/config';
import { localizePath } from '@/i18n/paths';
import { routes } from '@/lib/routes';
import { site } from '@/lib/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<footer class="colophon">
  <ul>
    {site.socials.map((s) => (
      <li>
        <a href={s.href} rel="me noopener" target="_blank">
          {s.label}
        </a>
      </li>
    ))}
    <li>
      <a href={localizePath(routes.rss(), locale)}>RSS</a>
    </li>
  </ul>
  <p>
    © {new Date().getFullYear()} {site.author.name}
  </p>
</footer>
