---
/**
 * EN / ID switch. Every page exists in both locales (untranslated items render an English
 * fallback under /id), so the toggle can always swap the prefix.
 */
import { LOCALE_META, LOCALES, type Locale } from '@/i18n/config';
import { alternatesFor } from '@/i18n/paths';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const alternates = alternatesFor(Astro.url.pathname);
---

<div class="flex items-center gap-1 text-xs" role="group" aria-label="Language">
  {LOCALES.map((l) =>
    l === locale ? (
      <span aria-current="true" class="rounded px-1.5 py-0.5 font-semibold">
        {LOCALE_META[l].label}
      </span>
    ) : (
      <a
        href={alternates[l]}
        hreflang={LOCALE_META[l].htmlLang}
        lang={LOCALE_META[l].htmlLang}
        class="rounded px-1.5 py-0.5 text-(--color-muted) hover:text-(--color-fg)"
      >
        {LOCALE_META[l].label}
      </a>
    ),
  )}
</div>
