---
/**
 * EN / ID switch, a six-spoke asterisk between the two. Every page exists in both locales (untranslated items render an English
 * fallback under /id), so the toggle can always swap the prefix.
 */
import { LOCALE_META, LOCALES, type Locale } from '@/i18n/config';
import { alternatesFor } from '@/i18n/paths';
import { t } from '@/i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const alternates = alternatesFor(Astro.url.pathname);
---

<div class="switch" role="group" aria-label={t(locale, 'language.label')}>
  {LOCALES.map((l, i) => [
    i > 0 && (
      <svg class="switch__star" viewBox="0 0 10 10" aria-hidden="true" focusable="false">
        <path d="M5 .5v9M1.1 2.75l7.8 4.5M8.9 2.75l-7.8 4.5" fill="none" stroke="currentColor" stroke-width="1" />
      </svg>
    ),
    l === locale ? (
      <span aria-current="true" class="switch__opt">
        {LOCALE_META[l].label}
      </span>
    ) : (
      <a href={alternates[l]} hreflang={LOCALE_META[l].htmlLang} lang={LOCALE_META[l].htmlLang} class="switch__opt">
        {LOCALE_META[l].label}
      </a>
    ),
  ])}
</div>
