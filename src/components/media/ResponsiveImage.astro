---
/**
 * The one image component for content. Emits <picture> with AVIF + WebP at quality 80,
 * responsive widths, intrinsic width/height (no layout shift) and lazy loading by default.
 * See docs/image-pipeline.md.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  priority?: boolean;
  class?: string;
  pictureClass?: string;
  title?: string;
}

const {
  src,
  alt,
  widths = [480, 960, 1440],
  sizes = '100vw',
  priority = false,
  class: className,
  pictureClass,
  title,
} = Astro.props;
// Never upscale past the original.
const usableWidths = [...new Set(widths.map((w) => Math.min(w, src.width)))];
---

<Picture
  src={src}
  alt={alt}
  title={title}
  formats={['avif', 'webp']}
  fallbackFormat="jpeg"
  quality={80}
  widths={usableWidths}
  width={Math.max(...usableWidths)}
  sizes={sizes}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding="async"
  class={className}
  pictureAttributes={{ class: pictureClass }}
/>
