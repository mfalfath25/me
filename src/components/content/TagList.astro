---
import type { Locale } from '@/i18n/config';
import { localizePath } from '@/i18n/paths';
import type { TagSummary } from '@/lib/content';
import { routes } from '@/lib/routes';

interface Props {
  tags: TagSummary[];
  locale: Locale;
}
const { tags, locale } = Astro.props;
---

{tags.length > 0 && (
  <ul class="flex flex-wrap gap-2 text-xs">
    {tags.map((tag) => (
      <li>
        <a
          href={localizePath(routes.tag(tag.slug), locale)}
          class="rounded-full border border-(--color-line) px-2.5 py-1 text-(--color-muted) hover:text-(--color-fg)"
        >
          #{tag.name}
        </a>
      </li>
    ))}
  </ul>
)}
