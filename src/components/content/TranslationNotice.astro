---
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<p role="note" class="mb-8 rounded-md border border-(--color-line) px-4 py-3 text-sm text-(--color-muted)">
  {t(locale, 'translation.unavailable')}
</p>
