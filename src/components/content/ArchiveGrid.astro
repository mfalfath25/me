---
/**
 * Static archive grid. Zero JS for now; the animated gallery (custom scroll, transitions,
 * lightbox) comes in the design pass as a React island that enhances this markup.
 */
import ResponsiveImage from '@/components/media/ResponsiveImage.astro';

import type { ArchiveItem } from '@/lib/content';

interface Props {
  items: ArchiveItem[];
  /** Number of images above the fold to load eagerly (LCP). */
  eager?: number;
}
const { items, eager = 3 } = Astro.props;
---

<ul class="grid grid-cols-2 gap-3 md:grid-cols-3" data-archive-grid>
  {items.map((item, i) =>
    item.kind === 'photo' ? (
      <li id={`photo-${item.slug}`} data-kind="photo" data-location={item.location ?? undefined}>
        <figure>
          <ResponsiveImage
            src={item.image}
            alt={item.alt}
            widths={[360, 720, 1080]}
            sizes="(min-width: 768px) 33vw, 50vw"
            priority={i < eager}
            class="aspect-square w-full rounded-sm object-cover"
          />
          <figcaption class="mt-1.5 text-xs text-(--color-muted)">
            {item.title}
            {item.location && <span> · {item.location}</span>}
          </figcaption>
        </figure>
      </li>
    ) : (
      <li id={`link-${item.slug}`} data-kind="link">
        <a
          href={item.url}
          rel="noopener"
          target="_blank"
          class="flex aspect-square flex-col justify-between rounded-sm border border-(--color-line) p-4 hover:border-(--color-fg)"
        >
          {item.image ? (
            <ResponsiveImage
              src={item.image}
              alt=""
              widths={[360, 720]}
              sizes="(min-width: 768px) 33vw, 50vw"
              class="aspect-[1.91/1] w-full rounded-sm object-cover"
            />
          ) : (
            <span class="text-xs text-(--color-muted)">↗ {item.host}</span>
          )}
          <span>
            <span class="block font-medium">{item.title}</span>
            {item.note && <span class="mt-1 line-clamp-3 block text-sm text-(--color-muted)">{item.note}</span>}
            <span class="mt-2 block text-xs text-(--color-muted)">{item.siteName ?? item.host}</span>
          </span>
        </a>
      </li>
    ),
  )}
</ul>
