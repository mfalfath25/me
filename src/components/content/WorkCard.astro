---
/**
 * One Work as a compact card: a 48px square cover thumbnail (pixelated at rest by work-tiles.ts)
 * beside its status, title and summary. Hovering or focusing the card draws a marker scribble: a
 * hand-drawn box round the card and one to three arrows pointing in, dealt afresh by work-tiles.ts
 * for every hover. The SVG starts empty, so without script there is no scribble.
 */
import ResponsiveImage from '@/components/media/ResponsiveImage.astro';
import type { Locale } from '@/i18n/config';
import { localizePath } from '@/i18n/paths';
import { t } from '@/i18n/ui';
import type { Work } from '@/lib/content';
import { routes } from '@/lib/routes';

interface Props {
  work: Work;
  locale: Locale;
}
const { work, locale } = Astro.props;
---

<article class={work.cover ? 'work' : 'work work--plain'} data-reveal>
  <a href={localizePath(routes.work(work.slug), locale)} class="work__link">
    {work.cover && (
      <span class="work__cover">
        <ResponsiveImage src={work.cover} alt={work.coverAlt} widths={[96, 144]} sizes="48px" />
        <canvas class="work__pixels" aria-hidden="true"></canvas>
      </span>
    )}
    <div class="work__text">
      <p class="meta">
        {t(locale, `works.status.${work.status}`)}
        {work.period && <span>, {work.period}</span>}
      </p>
      <h3 class="work__title" lang={work.locale}>
        {work.title}
      </h3>
      <p class="work__summary" lang={work.locale}>
        {work.summary}
      </p>
    </div>
  </a>
  <svg class="scribble" aria-hidden="true"></svg>
</article>
