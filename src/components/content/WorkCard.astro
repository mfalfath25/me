---
/** One Work as a square tile of whole grid cells: cover above, status, title and summary below. */
import ResponsiveImage from '@/components/media/ResponsiveImage.astro';
import type { Locale } from '@/i18n/config';
import { localizePath } from '@/i18n/paths';
import { t } from '@/i18n/ui';
import type { Work } from '@/lib/content';
import { routes } from '@/lib/routes';

interface Props {
  work: Work;
  locale: Locale;
}
const { work, locale } = Astro.props;
---

<article class={work.cover ? 'work' : 'work work--plain'}>
  <a href={localizePath(routes.work(work.slug), locale)} class="work__link">
    {work.cover && (
      <span class="work__cover">
        <ResponsiveImage
          src={work.cover}
          alt={work.coverAlt}
          widths={[480, 960]}
          sizes="(min-width: 768px) 384px, 288px"
          pictureClass="tile__picture"
        />
      </span>
    )}
    <div class="work__text">
      <p class="meta">
        {t(locale, `works.status.${work.status}`)}
        {work.period && <span>, {work.period}</span>}
      </p>
      <h3 class="work__title" lang={work.locale}>
        {work.title}
      </h3>
      <p class="work__summary" lang={work.locale}>
        {work.summary}
      </p>
      {!work.cover && work.stack.length > 0 && <p class="work__stack meta">{work.stack.join(', ')}</p>}
    </div>
  </a>
</article>
