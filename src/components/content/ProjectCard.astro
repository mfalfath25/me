---
import ResponsiveImage from '@/components/media/ResponsiveImage.astro';
import type { Locale } from '@/i18n/config';
import { localizePath } from '@/i18n/paths';
import { t } from '@/i18n/ui';
import type { Project } from '@/lib/content';
import { routes } from '@/lib/routes';

interface Props {
  project: Project;
  locale: Locale;
}
const { project, locale } = Astro.props;
---

<article class="group">
  <a href={localizePath(routes.project(project.slug), locale)} class="block">
    {project.cover && (
      <ResponsiveImage
        src={project.cover}
        alt={project.coverAlt}
        widths={[480, 960]}
        sizes="(min-width: 768px) 50vw, 100vw"
        class="aspect-[3/2] w-full rounded-md object-cover"
      />
    )}
    <p class="mt-3 text-xs text-(--color-muted)">
      {t(locale, `projects.status.${project.status}`)}
      {project.period && <span> · {project.period}</span>}
    </p>
    <h3 class="mt-1 text-lg font-medium group-hover:underline" lang={project.locale}>
      {project.title}
    </h3>
    <p class="mt-1 text-sm text-(--color-muted)" lang={project.locale}>
      {project.summary}
    </p>
  </a>
</article>
