---
/** One Post as a single grid row: date in the first two cells, title and description beside it. */
import type { Locale } from '@/i18n/config';
import { localizePath } from '@/i18n/paths';
import { formatDate, t } from '@/i18n/ui';
import type { Post } from '@/lib/content';
import { routes } from '@/lib/routes';

interface Props {
  post: Post;
  locale: Locale;
}
const { post, locale } = Astro.props;
---

<article class="row">
  <a href={localizePath(routes.post(post.slug), locale)} class="row__link">
    <time class="row__date" datetime={post.publishedAt.toISOString()}>
      {formatDate(post.publishedAt, locale)}
    </time>
    <div class="row__body">
      <h3 class="row__title" lang={post.locale}>
        {post.title}
        {post.isHidden && <span class="meta"> ({t(locale, 'draft')})</span>}
      </h3>
      <p class="row__desc" lang={post.locale}>
        {post.series && <span>{post.series.title}. </span>}
        {post.description}
      </p>
    </div>
  </a>
</article>
