---
import type { Locale } from '@/i18n/config';
import { localizePath } from '@/i18n/paths';
import { formatDate, t } from '@/i18n/ui';
import type { Post } from '@/lib/content';
import { routes } from '@/lib/routes';

interface Props {
  post: Post;
  locale: Locale;
}
const { post, locale } = Astro.props;
---

<article class="group py-5">
  <a href={localizePath(routes.post(post.slug), locale)} class="block">
    <p class="text-xs text-(--color-muted)">
      <time datetime={post.publishedAt.toISOString()}>{formatDate(post.publishedAt, locale)}</time>
      {post.series && <span> · {post.series.title}</span>}
      {post.isHidden && <span> · {t(locale, 'draft')}</span>}
    </p>
    <h3 class="mt-1 text-lg font-medium group-hover:underline" lang={post.locale}>
      {post.title}
    </h3>
    <p class="mt-1 text-sm text-(--color-muted)" lang={post.locale}>
      {post.description}
    </p>
  </a>
</article>
